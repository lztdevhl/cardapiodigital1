# PostgreSQL usado pelo Prisma. Na Vercel, mapeie a URL do Prisma Postgres para este nome.
DATABASE_URL=

# Chave de assinatura da sessão administrativa (mínimo de 32 caracteres).
SESSION_SECRET=

# Credenciais server-side necessárias para upload de imagens em produção.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Usadas somente por `npm run db:seed` para criar ou atualizar o administrador inicial.
ADMIN_EMAIL=
ADMIN_PASSWORD=
